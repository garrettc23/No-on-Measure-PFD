---
// Never send local development or preview visits to the advertising account.
const enabled = import.meta.env.PROD && import.meta.env.VERCEL_ENV === 'production';
const isHomepage = Astro.url.pathname === '/';
---
{enabled && <>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18535242073"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18535242073');
  </script>
  {isHomepage && <script is:inline>
    // Event snippet for Page view (1), after the Google tag.
    gtag('event', 'conversion', {
      'send_to': 'AW-18535242073/DwMFCImxo6kdENmypYZF',
      'value': 1.0,
      'currency': 'USD'
    });
  </script>}
</>}
