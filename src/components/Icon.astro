---
interface Props { name?: 'arrow' | 'download' | 'external' | 'calendar' | 'plus' | 'check' | 'share'; size?: number; }
const { name = 'arrow', size = 20 } = Astro.props;
const paths = {
  arrow: 'M4 12h15M13 5l7 7-7 7',
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  external: 'M7 17 19 5M7 5h12v12',
  calendar: 'M8 2v4m8-4v4M3 10h18M3 5h18v17H3zM7 14h3m4 0h3m-10 4h3',
  plus: 'M12 5v14M5 12h14',
  check: 'm5 12 4 4L19 6',
  share: 'M12 16V3m-5 5 5-5 5 5M5 12H3v9h18v-9h-2',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
