---
export interface ResourceTile {
  href: string;
  title: string;
  text: string;
  action: string;
  download?: string;
}
interface Props { items: ResourceTile[]; label: string; className?: string; columns?: 2 | 3; }
const { items, label, className, columns = 3 } = Astro.props;
---
<nav class:list={['resource-tiles', className, { 'two-columns': columns === 2 }]} aria-label={label}>
  {items.map(item => <article class="resource-card">
    <h3>{item.title}</h3>
    <p>{item.text}</p>
    <a class="button button-outline" href={item.href} download={item.download}>{item.action}<span class="sr-only">: {item.title}</span></a>
  </article>)}
</nav>
<style>
  .resource-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .resource-tiles.two-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .resource-card { display: grid; grid-template-rows: auto 1fr auto; gap: 16px; padding: var(--space-panel); border: 1px solid var(--line); border-radius: var(--radius-surface); background: var(--paper-deep); min-width: 0; }
  .resource-card h3 { margin: 0; font-size: 22px; line-height: 1.35; }
  .resource-card p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--green-soft); }
  .resource-card .button { justify-self: start; margin-top: 8px; background: var(--paper); }
  .resource-card .button:hover { background: var(--green); color: var(--paper); }
  @media (max-width: 1100px) { .resource-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .resource-tiles, .resource-tiles.two-columns { grid-template-columns: 1fr; } }
</style>
