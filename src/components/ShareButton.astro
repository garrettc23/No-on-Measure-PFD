---
import Icon from './Icon.astro';
---
<div class="share-control">
  <button type="button" class="text-link share-button">Share with a neighbor <Icon name="share" /></button>
  <span class="share-status" role="status"></span>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.share-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector<HTMLElement>('.share-status');
      const url = new URL('/', window.location.href).href;
      try {
        if (navigator.share) {
          await navigator.share({ title: 'No on Measure PFD', url });
        } else {
          await navigator.clipboard.writeText(url);
          if (status) status.textContent = 'Link copied.';
        }
      } catch (error) {
        if (error instanceof Error && error.name === 'AbortError') return;
        // Clipboard access can be unavailable outside a secure context.
        if (status) status.textContent = `Copy this link: ${url}`;
      }
    });
  });
</script>
