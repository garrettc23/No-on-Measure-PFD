<button class="fullscreen-enter" type="button" aria-label="Enter fullscreen" title="Fullscreen" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 14H5v5h5v-2H7v-3Zm-2-4h2V7h3V5H5v5Zm12 7h-3v2h5v-5h-2v3ZM14 5v2h3v3h2V5h-5Z" /></svg>
</button>
<div class="fullscreen-toolbar" role="group" aria-label="Video controls">
  <button class="fullscreen-play" type="button" aria-label="Pause video" title="Pause (Space)">
    <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" fill="currentColor" stroke="none" /></svg>
    <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke-width="4" /></svg>
  </button>
  <span class="fullscreen-time" aria-hidden="true">0:00 / 0:30</span>
  <input class="fullscreen-seek" type="range" min="0" max="30" step="0.1" value="0" aria-label="Seek video" />
  <button class="fullscreen-mute" type="button" aria-label="Mute audio" aria-pressed="false" title="Mute (M)">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4 6 8H3v8h3l5 4Z" /><path class="sound-waves" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /><path class="sound-muted" d="m16 9 6 6m0-6-6 6" /></svg>
  </button>
  <input class="fullscreen-volume" type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
  <button class="fullscreen-captions" type="button" aria-label="Closed captions" aria-pressed="false" title="Closed captions"><span>CC</span></button>
  <button class="fullscreen-exit" type="button" aria-label="Exit fullscreen" title="Exit fullscreen (Esc)">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h5V3m8 0v5h5M3 16h5v5m8 0v-5h5" /></svg>
  </button>
</div>

<script>
  const video = document.querySelector<HTMLVideoElement>('#campaign-video');
  const player = video?.closest<HTMLElement>('.hero-video');
  const enter = player?.querySelector<HTMLButtonElement>('.fullscreen-enter');
  const toolbar = player?.querySelector<HTMLDivElement>('.fullscreen-toolbar');

  if (video && player && enter && toolbar && document.fullscreenEnabled) {
    const play = toolbar.querySelector<HTMLButtonElement>('.fullscreen-play')!;
    const seek = toolbar.querySelector<HTMLInputElement>('.fullscreen-seek')!;
    const time = toolbar.querySelector<HTMLSpanElement>('.fullscreen-time')!;
    const mute = toolbar.querySelector<HTMLButtonElement>('.fullscreen-mute')!;
    const volume = toolbar.querySelector<HTMLInputElement>('.fullscreen-volume')!;
    const captions = toolbar.querySelector<HTMLButtonElement>('.fullscreen-captions')!;
    const exit = toolbar.querySelector<HTMLButtonElement>('.fullscreen-exit')!;
    let restoringControls = true;
    let active = false;
    const isFullscreen = () => document.fullscreenElement === player;
    let controlsTimeout: ReturnType<typeof setTimeout> | undefined;
    let pointerOverControls = false;
    const overFullscreenButton = (event: MouseEvent) => {
      const rect = enter.getBoundingClientRect();
      return !enter.hidden && !isFullscreen() && event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom;
    };
    const hideInlineButton = () => {
      if (!video.paused && !video.ended && !isFullscreen() && !pointerOverControls && !enter.matches(':hover, :focus-visible')) {
        enter.classList.add('is-idle');
      }
    };
    const showInlineButton = () => {
      clearTimeout(controlsTimeout);
      enter.classList.remove('is-idle');
      if (!video.paused && !video.ended && !isFullscreen()) {
        controlsTimeout = setTimeout(hideInlineButton, 2500);
      }
    };
    player.addEventListener('pointermove', (event) => {
      pointerOverControls = event.pointerType === 'mouse' && event.clientY >= video.getBoundingClientRect().bottom - 84;
      enter.classList.toggle('is-hovered', overFullscreenButton(event));
      showInlineButton();
    });
    for (const event of ['pointerdown', 'keydown', 'focusin']) player.addEventListener(event, showInlineButton);
    player.addEventListener('pointerleave', () => {
      pointerOverControls = false;
      enter.classList.remove('is-hovered');
      clearTimeout(controlsTimeout);
      hideInlineButton();
    });
    enter.addEventListener('blur', showInlineButton);
    for (const event of ['play', 'pause', 'ended', 'seeking', 'seeked']) video.addEventListener(event, showInlineButton);
    const formatTime = (seconds: number) => {
      const total = Math.max(0, Math.floor(seconds || 0));
      return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
    };
    const update = () => {
      play.classList.toggle('is-paused', video.paused);
      play.title = video.paused ? 'Play (Space)' : 'Pause (Space)';
      play.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video');
      const duration = Number.isFinite(video.duration) ? video.duration : 30;
      seek.max = String(duration);
      seek.value = String(video.currentTime);
      seek.style.setProperty('--progress', `${duration > 0 ? video.currentTime / duration * 100 : 0}%`);
      seek.setAttribute('aria-valuetext', `${formatTime(video.currentTime)} of ${formatTime(duration)}`);
      time.textContent = `${formatTime(video.currentTime)} / ${formatTime(duration)}`;
      mute.title = video.muted ? 'Unmute (M)' : 'Mute (M)';
      mute.setAttribute('aria-label', video.muted ? 'Unmute audio' : 'Mute audio');
      mute.setAttribute('aria-pressed', String(video.muted));
      volume.value = String(video.muted ? 0 : video.volume);
      volume.style.setProperty('--progress', `${Number(volume.value) * 100}%`);
      captions.setAttribute('aria-pressed', String(video.textTracks[0]?.mode === 'showing'));
      if (isFullscreen() && video.controls) video.controls = false;
    };
    const requestFullscreen = async () => {
      restoringControls = video.controls;
      try {
        await player.requestFullscreen();
      } catch {
        // Keep inline playback working if the browser declines fullscreen.
        video.controls = restoringControls;
      }
    };
    // Fullscreen the complete player so the control row sits outside the picture.
    video.setAttribute('controlslist', 'nofullscreen');
    video.classList.add('has-fullscreen-controls');
    enter.addEventListener('click', requestFullscreen);
    // Keep pointer hover on the native panel so all controls share its timing.
    // The overlay retains a keyboard target; pointer clicks use the same action.
    player.addEventListener('click', (event) => {
      if (event.detail === 0 || !video.controls || !overFullscreenButton(event) || enter.classList.contains('is-idle')) return;
      event.preventDefault();
      event.stopPropagation();
      void requestFullscreen();
    }, { capture: true });
    video.addEventListener('dblclick', (event) => {
      event.preventDefault();
      if (isFullscreen()) void document.exitFullscreen();
      else void requestFullscreen();
    });
    video.addEventListener('playing', () => { enter.hidden = false; showInlineButton(); });
    video.addEventListener('error', () => {
      if (isFullscreen()) void document.exitFullscreen();
    });
    play.addEventListener('click', async () => {
      if (!video.paused) video.pause();
      else {
        try { await video.play(); }
        catch { if (isFullscreen()) await document.exitFullscreen(); }
      }
    });
    seek.addEventListener('input', () => { video.currentTime = Number(seek.value); });
    mute.addEventListener('click', () => { video.muted = !video.muted; });
    volume.addEventListener('input', () => { video.volume = Number(volume.value); video.muted = video.volume === 0; });
    captions.addEventListener('click', () => {
      const track = video.textTracks[0];
      if (track) track.mode = track.mode === 'showing' ? 'disabled' : 'showing';
    });
    exit.addEventListener('click', () => { void document.exitFullscreen(); });
    document.addEventListener('fullscreenchange', () => {
      showInlineButton();
      if (isFullscreen()) {
        active = true;
        video.controls = false;
        update();
        play.focus({ preventScroll: true });
      } else if (active) {
        active = false;
        video.controls = restoringControls;
        enter.focus({ preventScroll: true });
      }
    });
    player.addEventListener('keydown', (event) => {
      if (!isFullscreen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        void document.exitFullscreen();
        return;
      }
      if (event.key === 'Tab') {
        const controls = Array.from(toolbar.querySelectorAll<HTMLElement>('button, input')).filter(control => control.getClientRects().length > 0);
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
      if ((event.key === ' ' || event.key === 'k') && event.target === video) {
        event.preventDefault();
        play.click();
      }
    });
    for (const event of ['timeupdate', 'durationchange', 'play', 'pause', 'ended', 'volumechange', 'error']) video.addEventListener(event, update);
    video.textTracks.addEventListener('change', update);
  }
</script>

<style>
  /* Reserve a slot beside the native sound and menu buttons. */
  .fullscreen-enter { position: absolute; bottom: 26px; right: 12px; display: grid; place-items: center; width: 44px; height: 44px; padding: 10px; border: 0; border-radius: 0; background: transparent; color: #fff; cursor: pointer; opacity: .95; transition: opacity 300ms ease; }
  .fullscreen-enter::before { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: rgb(32 33 36 / 70%); opacity: 0; transition: opacity 150ms ease; }
  .fullscreen-enter svg { position: relative; }
  .fullscreen-enter { pointer-events: none; }
  .fullscreen-enter.is-hovered, .fullscreen-enter:focus-visible { opacity: 1; }
  .fullscreen-enter.is-hovered::before, .fullscreen-enter:focus-visible::before { opacity: 1; }
  .fullscreen-enter:active::before { background: rgb(32 33 36 / 90%); }
  .fullscreen-enter.is-idle:not(:focus-visible) { opacity: 0; pointer-events: none; }
  .fullscreen-enter svg { width: 24px; height: 24px; fill: currentColor; stroke: none; }
  .fullscreen-enter[hidden] { display: none; }
  svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .fullscreen-toolbar { display: none; }
  :global(video.has-fullscreen-controls::-webkit-media-controls-fullscreen-button) { display: none; }
  :global(video.has-fullscreen-controls::-webkit-media-controls-panel) { padding-right: 60px; }
  :global(video.has-fullscreen-controls::-webkit-media-controls-timeline) { margin-right: -60px; }
  :global(.hero-video:fullscreen) { display: grid; grid-template-rows: minmax(0, 1fr) auto; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; aspect-ratio: auto; background: #000; overflow: hidden; box-shadow: none; }
  :global(.hero-video:fullscreen > video) { grid-row: 1; width: 100%; height: 100%; min-height: 0; object-fit: contain; object-position: center; }
  :global(.hero-video:fullscreen) .fullscreen-enter { display: none; }
  :global(.hero-video:fullscreen) .fullscreen-toolbar { grid-row: 2; display: flex; align-items: center; gap: 12px; padding: 8px max(24px, env(safe-area-inset-right)) max(8px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left)); background: linear-gradient(#16191e, #101216); color: #fff; border-top: 1px solid #ffffff12; font: 13px / 1.3 var(--sans); }
  .fullscreen-toolbar button { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; padding: 10px; border: 0; border-radius: 50%; background: transparent; color: #eceef2; cursor: pointer; transition: background 160ms ease, color 160ms ease; }
  .fullscreen-toolbar button:hover { background: #ffffff14; color: #fff; }
  .fullscreen-toolbar .fullscreen-play { background: #fff; color: #101216; }
  .fullscreen-toolbar .fullscreen-play:hover { background: #dfe3e9; }
  .icon-play, .is-paused .icon-pause, .sound-muted, [aria-pressed="true"] .sound-waves { display: none; }
  .is-paused .icon-play, [aria-pressed="true"] .sound-muted { display: block; }
  .fullscreen-captions span { padding: 1px 3px; border: 1.5px solid currentColor; border-radius: 3px; font-size: 11px; line-height: 14px; font-weight: 700; letter-spacing: -.04em; }
  .fullscreen-captions[aria-pressed="true"] span { background: #fff; color: #101216; border-color: #fff; }
  .fullscreen-toolbar input { --progress: 0%; appearance: none; -webkit-appearance: none; height: 44px; padding: 0; margin: 0; background: transparent; cursor: pointer; }
  .fullscreen-toolbar input::-webkit-slider-runnable-track { height: 3px; border-radius: 3px; background: linear-gradient(to right, #fff var(--progress), #ffffff30 var(--progress)); }
  .fullscreen-toolbar input::-moz-range-track { height: 3px; border-radius: 3px; background: linear-gradient(to right, #fff var(--progress), #ffffff30 var(--progress)); }
  .fullscreen-toolbar input::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 12px; height: 12px; margin-top: -4.5px; border-radius: 50%; background: #fff; box-shadow: 0 1px 5px #0006; }
  .fullscreen-toolbar input::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: #fff; box-shadow: 0 1px 5px #0006; }
  .fullscreen-time { font-variant-numeric: tabular-nums; white-space: nowrap; color: #c9cdd5; }
  .fullscreen-seek { flex: 1; min-width: 40px; }
  .fullscreen-volume { width: 64px; }
  .fullscreen-toolbar :focus-visible, .fullscreen-enter:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @media (max-width: 700px) {
    :global(.hero-video:fullscreen) .fullscreen-toolbar { flex-wrap: wrap; column-gap: 8px; row-gap: 0; padding: 0 max(12px, env(safe-area-inset-right)) max(8px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left)); }
    .fullscreen-seek { order: -1; flex-basis: 100%; }
    .fullscreen-volume { display: none; }
    .fullscreen-time { margin-right: auto; font-size: 12px; }
  }
  /* Short landscape screens need a single row to leave room for the picture. */
  @media (orientation: landscape) and (max-height: 500px) and (min-width: 480px) {
    :global(.hero-video:fullscreen) .fullscreen-toolbar { flex-wrap: nowrap; gap: 8px; padding: 4px max(12px, env(safe-area-inset-right)) max(4px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left)); }
    .fullscreen-seek { order: 0; flex: 1; min-width: 40px; }
    .fullscreen-volume { display: none; }
    .fullscreen-time { margin-right: 0; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fullscreen-toolbar button, .fullscreen-enter, .fullscreen-enter::before { transition: none; }
  }
</style>
