---
import { getImage } from 'astro:assets';
import CampaignVideo from './CampaignVideo.astro';
import cityHall from '../assets/pasadena-city-hall-sunset.jpg';
const poster = await getImage({ src: cityHall, width: 944, height: 531, fit: 'cover', position: 'top', format: 'webp', quality: 85 });
---
<CampaignVideo id="campaign-video" src="/videos/measure-pfd-commercial.mp4" poster={poster.src} captions="/videos/measure-pfd-commercial.en.vtt" label="the No on PFD commercial">
  <Fragment slot="title">Watch The <span class="video-title-emphasis">No On PFD</span> Commercial</Fragment>
</CampaignVideo>
