---
import '@fontsource-variable/archivo';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Analytics from '@vercel/analytics/astro';
import Icon from '../components/Icon.astro';
import { campaign } from '../data/campaign';
import { titleCase } from '../utils/titleCase';
import { absoluteUrl, allowIndexing, serializeSchema, publicPages } from '../utils/seo';
interface Props { title?: string; description?: string; seoTitle?: string; noindex?: boolean; structuredData?: Record<string, unknown>; }
const { title = campaign.name, description = campaign.description, seoTitle, noindex = false, structuredData = {} } = Astro.props;
const path = Astro.url.pathname;
const nav = [{ href: '/', label: 'Home' }, { href: '/facts/', label: 'Facts & FAQ' }, { href: '/bill-paparian/', label: 'Former Pasadena Mayor’s Take' }];
const canonical = absoluteUrl(path);
const pageTitle = seoTitle || titleCase(title === campaign.name ? `${title} | Pasadena Parcel Tax, November 2026` : `${title} | ${campaign.name}`);
const indexable = allowIndexing && !noindex;
const organizationId = absoluteUrl('/#organization');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: 'Committee for Responsible Property Taxation – Opposing Measure PFD, Sponsored by REALTORS®', alternateName: campaign.name, url: absoluteUrl('/'), logo: absoluteUrl('/campaign-logo.png'), description: 'The campaign opposing Pasadena’s proposed Measure PFD parcel tax.' },
    { '@type': 'WebSite', '@id': absoluteUrl('/#website'), url: absoluteUrl('/'), name: campaign.name, publisher: { '@id': organizationId }, inLanguage: 'en-US' },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: pageTitle, description, isPartOf: { '@id': absoluteUrl('/#website') }, publisher: { '@id': organizationId }, inLanguage: 'en-US', ...structuredData },
    ...(path !== '/' && !noindex ? [{ '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: publicPages.find(page => page.path === path)?.name || title, item: canonical },
    ] }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#012755" />
    <meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex, follow"} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <script type="application/ld+json" set:html={serializeSchema(schema)} />}
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} /><meta property="og:site_name" content={campaign.name} /><meta property="og:locale" content="en_US" />
    <meta property="og:image" content={absoluteUrl('/vote-no-pasadena-city-hall.png')} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vote No on Measure PFD logo with Pasadena City Hall behind it" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absoluteUrl('/vote-no-pasadena-city-hall.png')} />
    <Analytics />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class:list={{ 'home-page': path === '/' }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="election-top"><span>Pasadena, California</span><span>Vote No on November 3, 2026</span></div>
    <header class="site-header">
      <div class="container header-inner">
        <Logo />
        <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-navigation" type="button"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></button>
        <nav id="main-navigation" aria-label="Main navigation">
          {nav.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
          {campaign.donationUrl && <a href={campaign.donationUrl} target="_blank" rel="noopener noreferrer" class="button button-small">Donate<span class="sr-only"> (opens in a new tab)</span> <Icon /></a>}
          <a href="/join/#signup" class="button button-small">Vote NO <Icon size={17} /></a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <Logo footer />
          <div class="footer-bottom"><p data-legal-copy>{campaign.disclosure}<span class="top-funder">{campaign.topFunder}</span></p></div>
          <div class="footer-nav"><a href="/facts/">Facts & FAQ</a><a href="/join/">Join the campaign</a><a href="/bill-paparian/">Mayor’s Take</a><a href="/vote/">How to vote</a><a href="/privacy/">Privacy</a></div>
        </div>
      </div>
    </footer>
    <div class="mobile-pledge"><a href="/join/#signup" class="button button-small">Vote NO <Icon size={17} /></a></div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-navigation');
      function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
      document.addEventListener('click', event => { if (event.target instanceof Node && !nav?.contains(event.target) && !toggle?.contains(event.target)) closeMenu(); });
      matchMedia('(min-width: 801px)').addEventListener('change', closeMenu);
    </script>
  </body>
</html>
