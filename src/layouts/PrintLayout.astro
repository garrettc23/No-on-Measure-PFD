---
import '@fontsource-variable/dm-sans';
import CampaignMark from '../components/CampaignMark.astro';
import { campaign } from '../data/campaign';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>{title} | {campaign.name}</title><style is:global>
@page{size:letter;margin:0.48in 0.55in}*{box-sizing:border-box}body{margin:0;font-family:'DM Sans Variable',Arial,sans-serif;color:#233e34;font-size:10pt;line-height:1.48;background:#fffdf8}header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #233e34;padding-bottom:12px;margin-bottom:22px}.print-logo{width:150px}.print-tagline{font-size:8pt;text-align:right}.kicker{font-size:8pt;text-transform:uppercase;letter-spacing:1px;color:#a94332;font-weight:650}h1{font-family:Georgia,'Times New Roman',serif;font-size:31pt;line-height:1.1;letter-spacing:-1px;font-weight:500;margin:9px 0 13px}h2{font-size:11pt;font-weight:650;line-height:1.4;margin:0 0 7px}p{margin:0 0 12px}.intro{font-size:10pt;line-height:1.55}table{width:100%;border-collapse:collapse;font-size:8.6pt;line-height:1.4;margin-top:15px}th,td{text-align:left;vertical-align:top;padding:8px 0;border-bottom:1px solid #d8d8cb}th{width:27%;padding-right:17px;font-weight:650}small{display:block;color:#59665c;font-size:7.5pt;margin-top:3px}a{color:#233e34;text-underline-offset:2px;overflow-wrap:anywhere}.position{border-left:3px solid #a94332;padding:9px 14px;background:#f0eddf;margin:18px 0 14px}.position p{margin:0;font-size:9pt}.position h2{font-size:10pt}.source{font-size:7.2pt;line-height:1.45;color:#59665c}.source p{margin:5px 0}.print-footer{border-top:1px solid #d8d8cb;padding-top:10px;margin-top:18px;font-size:7pt;line-height:1.6}.faq-print{break-inside:avoid;margin:0 0 20px}.faq-print p{margin:0 0 5px;font-size:9.4pt;line-height:1.55}.faq-print small{font-size:7.2pt}.faq-page+.faq-page{break-before:page}.faq-page>h1{margin-bottom:20px}.preview-label{color:#59665c;font-size:7pt;text-transform:uppercase;letter-spacing:.5px}@media screen{body{max-width:8.5in;padding:.48in .55in;margin:auto}.faq-page+.faq-page{margin-top:50px;padding-top:30px;border-top:1px solid #ccc}}
</style></head><body><header><div class="print-logo"><CampaignMark /></div><div class="print-tagline">Support public safety.<br />Keep Pasadena affordable.</div></header><slot /><footer class="print-footer">{campaign.disclosure}<br />Campaign contact: {campaign.contact.name} · {campaign.contact.email} · {campaign.contact.phone}<br /><span class="preview-label">Local preview · Campaign material · September 2026</span></footer></body></html>
