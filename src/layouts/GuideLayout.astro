---
import Layout from './Layout.astro';
import RelatedResources from '../components/RelatedResources.astro';
import { type Guide, referenceSources } from '../data/guides';
interface Props { guide: Guide; heading: string; }
const { guide, heading } = Astro.props;
const reviewLabel = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(guide.reviewed));
---
<Layout title={heading} seoTitle={guide.title} description={guide.description} article={{ modified: guide.reviewed, citations: guide.sources.map(key => referenceSources[key].url) }}>
  <article class="reference-page container">

    <header class="reference-header"><h1>{heading}</h1></header>
    <slot />
    <p class="guide-sources">Sources: {guide.sources.map((key, index) => <><a href={referenceSources[key].url} type={referenceSources[key].url.endsWith('.pdf') ? 'application/pdf' : undefined}>{referenceSources[key].title}</a>{index < guide.sources.length - 1 ? '; ' : '.'}</>)} Reviewed {reviewLabel}.</p>
    <section aria-labelledby="related-heading">
      <div class="related-heading"><h2 id="related-heading">Explore the measure</h2><a class="button button-outline" href="/resources/">Browse all resources</a></div>
      <RelatedResources />
    </section>
  </article>
</Layout>

<style>
  .guide-sources { font-size: 14px; line-height: 1.7; color: var(--green-soft); margin-block: 32px; }
  .related-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-copy); margin-bottom: var(--space-content); }
  .related-heading h2 { margin: 0; }
  .related-heading > .button { margin-left: auto; }
</style>
