---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Closing from '../components/Closing.astro';
import { facts, faqs, sources } from '../data/campaign';
---
<Layout title="Facts & FAQ" description="Read the cost, duration, exemptions, and oversight provisions of Pasadena’s Measure PFD, with links to the official ordinance and election resources.">
  <section class="page-intro container"><h1>The details<br />behind the decision.</h1><div class="intro-bottom"><p>We support Pasadena’s firefighters and paramedics. Here’s what Measure PFD would do, what it would cost, and why our campaign is asking for a fairer plan.</p><a href="/downloads/measure-pfd-fact-sheet.pdf" download class="button button-outline">Download the fact sheet <Icon name="download" /></a></div></section>
  <section id="measure" class="facts-section container section-anchor">
    <div class="section-heading"><h2>What the<br />measure says.</h2></div>
    <div class="fact-table-wrap"><table class="fact-table"><caption class="sr-only">Measure PFD provisions</caption><thead><tr><th scope="col">The provision</th><th scope="col">The details</th></tr></thead><tbody>{facts.map(fact => <tr><th scope="row">{fact.label}</th><td>{fact.value}</td></tr>)}</tbody></table><p class="source-note">Property examples use taxable improved square footage and assume no exemption. Consult the City for an actual assessment.</p></div>
  </section>
  <section id="questions" class="faq-section section-anchor"><div class="container faq-layout"><div class="section-heading"><h2>Let’s get<br />into the details.</h2><a href="/downloads/measure-pfd-faq.pdf" download class="text-link">Download these FAQs <Icon name="download" /></a></div><div class="faq-list">{faqs.map((faq, i) => <details class="faq-item" open={i === 0}><summary><span>{faq.question}</span><span class="faq-toggle"><Icon name="plus" /></span></summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div></div></section>
  <section id="sources" class="resources-section container section-anchor"><div class="resource-heading"><div><h2>Read it firsthand.</h2></div><p>The original public documents,<br />plus campaign materials to take with you.</p></div><div class="resource-list">{Object.values(sources).map((source, i) => <a class="resource-row" href={source.url}><span class="resource-number">0{i + 1}</span><div><h3>{source.title}</h3><p>{source.description}</p></div><Icon name="external" size={24} /></a>)}<a href="/downloads/measure-pfd-fact-sheet.pdf" download class="resource-row"><span class="resource-number">04</span><div><h3>Campaign fact sheet</h3><p>A one-page summary of the measure’s terms and our position. PDF.</p></div><Icon name="download" size={24} /></a><a href="/downloads/measure-pfd-faq.pdf" download class="resource-row"><span class="resource-number">05</span><div><h3>Questions & answers</h3><p>The website’s full FAQ in a printable format. PDF.</p></div><Icon name="download" size={24} /></a></div></section>
  <Closing />
</Layout>
