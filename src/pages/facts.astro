---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Closing from '../components/Closing.astro';
import CampaignParagraphs from '../components/CampaignParagraphs.astro';
import { campaign, factSheetSections, faqs, sources, paragraphText } from '../data/campaign';
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question', name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: paragraphText(faq.paragraphs) },
  })),
};
---
<Layout title="Facts & FAQ" seoTitle="Facts & FAQ | Vote No on Measure PFD" description="Read the No on Measure PFD campaign’s fact sheet and 13 frequently asked questions about costs, housing, and fire funding. Download both PDFs." structuredData={faqSchema}>
  <section class="page-intro container">
    <h1>Measure PFD.<br />Your questions, answered.</h1>
    <div class="intro-bottom"><p>Read our campaign’s fact sheet and frequently asked questions about Measure PFD, Pasadena’s proposed parcel tax on the November 3, 2026 ballot.</p></div>
    <div class="document-downloads">
      <a href={campaign.factSheetUrl} download="No on Measure PFD Fact Sheet.pdf" class="button button-outline">Download fact sheet (PDF) <Icon name="download" /></a>
      <a href={campaign.faqUrl} download="No on Measure PFD FAQ.pdf" class="button button-outline">Download FAQs (PDF) <Icon name="download" /></a>
    </div>
  </section>
  <section id="measure" class="facts-section container section-anchor">
    <div class="section-heading"><h2>Campaign<br />fact sheet.</h2><p>Support Firefighters. Stop the Unfair Tax.</p></div>
    <div class="fact-sheet-copy">
      {factSheetSections.map(section => <article class="fact-sheet-section"><h3>{section.title}</h3><CampaignParagraphs paragraphs={section.paragraphs} /></article>)}
      <p class="fact-sheet-closing"><strong>Support Firefighters. Vote NO on Measure PFD.</strong><br />PFDNo.com</p>
    </div>
  </section>
  <section id="questions" class="faq-section section-anchor">
    <div class="container faq-layout">
      <div class="section-heading"><h2>Answers about<br />Measure PFD.</h2><p>Frequently asked questions from our campaign.</p></div>
      <div class="faq-list">{faqs.map(faq => <details class="faq-item section-anchor" id={faq.id}>
        <summary><span>{faq.question}</span><span class="faq-toggle"><Icon name="chevronDown" /></span></summary>
        <div class="faq-answer"><CampaignParagraphs paragraphs={faq.paragraphs} /></div>
      </details>)}</div>
    </div>
  </section>
  <section id="sources" class="resources-section container section-anchor">
    <div class="resource-heading"><div><h2>Read it firsthand.</h2></div></div>
    <div class="resource-list">
      {Object.values(sources).map((source, i) => <a class="resource-row" href={source.url} target="_blank" rel="noopener noreferrer"><span class="resource-number">0{i + 1}</span><div><h3>{source.title}<span class="sr-only"> (opens in a new tab)</span></h3><p>{source.description}</p></div><Icon name="external" size={24} /></a>)}
      <a href={campaign.factSheetUrl} download="No on Measure PFD Fact Sheet.pdf" class="resource-row"><span class="resource-number">04</span><div><h3>Campaign fact sheet</h3><p>Download fact sheet (PDF).</p></div><Icon name="download" size={24} /></a>
      <a href={campaign.faqUrl} download="No on Measure PFD FAQ.pdf" class="resource-row"><span class="resource-number">05</span><div><h3>Frequently asked questions</h3><p>Download FAQs (PDF).</p></div><Icon name="download" size={24} /></a>
      <a id="how-to-vote" href="/vote/" class="resource-row section-anchor"><span class="resource-number">06</span><div><h3>How to vote</h3><p>Official voting tools and deadlines.</p></div><Icon size={24} /></a>
    </div>
  </section>
  <Closing />
</Layout>

<style>
  .document-downloads { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 28px; }
  .fact-sheet-copy { min-width: 0; font-size: 18px; line-height: 1.75; color: var(--green-soft); }
  .fact-sheet-section + .fact-sheet-section { margin-top: 32px; padding-top: 32px; border-top: 1px solid var(--line); }
  .fact-sheet-section h3 { color: var(--green); font-size: 24px; line-height: 1.3; margin-bottom: 16px; }
  .fact-sheet-closing { margin-top: 32px; color: var(--green); }
  .faq-list > .faq-item:first-child { border-top: 1px solid #cdd5e1; }
  @media screen and (min-width: 801px) {
    .facts-section > .section-heading,
    .faq-layout > .section-heading { position: sticky; top: 150px; align-self: start; }
  }
  @media (max-width: 480px) {
    .document-downloads { flex-direction: column; align-items: stretch; }
    .document-downloads .button { white-space: normal; text-align: center; }
  }
</style>
