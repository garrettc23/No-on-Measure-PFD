---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Closing from '../components/Closing.astro';
import { campaign, facts, faqs, sources, faqGroups } from '../data/campaign';
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question', name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: [faq.answer, faq.note].filter(Boolean).join(' ') },
  })),
};
---
<Layout title="Facts & FAQ" seoTitle="Pasadena Measure PFD FAQ: Cost, Exemptions & Voting" description="What is Pasadena Measure PFD? Find answers about the proposed parcel tax, homeowner costs, exemptions, oversight, and the November 3, 2026 vote." structuredData={faqSchema}>
  <section class="page-intro container"><h1>Measure PFD.<br />Your questions, answered.</h1><div class="intro-bottom"><p>Measure PFD is a proposed Pasadena parcel tax on the November 3, 2026 ballot. Read the costs, exemptions, and voting rules below, with links to official sources and our campaign’s position.</p>{campaign.factSheetUrl && <a href={campaign.factSheetUrl} download class="button button-outline">Download the fact sheet <Icon name="download" /></a>}</div></section>
  <section id="measure" class="facts-section container section-anchor">
    <div class="section-heading"><h2>What the<br />measure says.</h2><p>Official provisions, arithmetic examples, and campaign estimates are labeled separately.</p></div>
    <div class="fact-table-wrap"><table class="fact-table"><caption class="sr-only">Measure PFD provisions</caption><thead><tr><th scope="col">The provision</th><th scope="col">The details</th></tr></thead><tbody>{facts.map(fact => <tr><th scope="row">{fact.label}</th><td>{fact.value}{fact.note && <small class="tax-estimate-note">{fact.note}</small>}</td></tr>)}</tbody></table></div>
  </section>
  <section id="questions" class="faq-section section-anchor">
    <div class="container faq-layout">
      <div class="section-heading"><h2>Answers about<br />Measure PFD.</h2><nav class="faq-topic-nav" aria-label="FAQ topics">{faqGroups.map(group => <a href={`#${group.id}`}>{group.title}</a>)}</nav><p class="faq-reviewed">Reviewed September 30, 2026. Published by the No on Measure PFD campaign.</p></div>
      <div class="faq-list">{faqGroups.map(group => <section class="faq-group section-anchor" id={group.id} aria-labelledby={`${group.id}-title`}>
        <h3 id={`${group.id}-title`}>{group.title}</h3>
        {faqs.filter(faq => faq.group === group.id).map((faq, i) => <details class="faq-item section-anchor" id={faq.id} open={i === 0}>
          <summary><span>{faq.question}</span><span class="faq-toggle"><Icon name="plus" /></span></summary>
          <div class="faq-answer"><p>{faq.answer}</p>{faq.note && <small class="source-note tax-estimate-note">{faq.note}</small>}<small class="source-note">{faq.sourceUrl ? <a href={faq.sourceUrl}>Source: {faq.reference}</a> : faq.reference}</small></div>
        </details>)}
      </section>)}</div>
    </div>
  </section>
  <section id="sources" class="resources-section container section-anchor"><div class="resource-heading"><div><h2>Read it firsthand.</h2></div></div><div class="resource-list">{Object.values(sources).map((source, i) => <a class="resource-row" href={source.url}><span class="resource-number">0{i + 1}</span><div><h3>{source.title}</h3><p>{source.description}</p></div><Icon name="external" size={24} /></a>)}{campaign.factSheetUrl && <a href={campaign.factSheetUrl} download class="resource-row"><span class="resource-number">04</span><div><h3>Campaign fact sheet</h3><p>Download the campaign fact sheet. PDF.</p></div><Icon name="download" size={24} /></a>}<a href="/downloads/measure-pfd-faq.pdf" download class="resource-row"><span class="resource-number">{campaign.factSheetUrl ? '05' : '04'}</span><div><h3>Questions & answers</h3><p>The website’s full FAQ in a printable format. PDF.</p></div><Icon name="download" size={24} /></a></div></section>
  <Closing />
</Layout>

<style>
  .faq-topic-nav { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; font-size: 16px; }
  .faq-group + .faq-group { margin-top: 40px; }
  .faq-group > h3 { margin-bottom: 16px; font-size: 22px; }
  .faq-group .faq-item:first-of-type { border-top: 1px solid #cdd5e1; }
  .section-heading .faq-reviewed { margin-top: 24px; font-size: 14px; line-height: 1.6; }
  .faq-answer .source-note { font-size: 14px; line-height: 1.6; }
</style>
