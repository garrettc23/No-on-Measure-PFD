---
import CampaignVideo from '../components/CampaignVideo.astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { paparian } from '../data/paparian';
const { latest, earlier } = paparian;
---
<Layout seoTitle="Bill Paparian on Pasadena’s Measure PFD | Vote No" title="Bill Paparian urges a NO vote on Measure PFD" description="Read former Pasadena Mayor Bill Paparian’s Pasadena Now and Pasadena Star-News commentaries opposing Measure PFD, with links to both articles.">
  <article class="editorial-article container">
    <header class="editorial-intro">
      <h1>Former Pasadena Mayor Bill Paparian urges a <span class="accent">NO vote on Measure PFD.</span></h1>
    </header>

    <section class="paparian-latest" aria-labelledby="latest-title">
      <figure class="paparian-video">
        <CampaignVideo id="paparian-video" src="/videos/bill-paparian.mp4" poster="/videos/bill-paparian-poster.webp" captions="/videos/bill-paparian.en.vtt" label="Bill Paparian on Measure PFD" />
      </figure>
      <div class="paparian-latest-copy">
        <p class="editorial-byline">{latest.publication} · <time datetime={latest.publishedDate}>{latest.published}</time></p>
        <h2 id="latest-title">{latest.title}</h2>
        <p>{latest.summary}</p>
        <a class="text-link" href={latest.url} target="_blank" rel="noopener noreferrer">Read the full op-ed on Pasadena Now<span class="sr-only"> (opens in a new tab)</span> <Icon name="external" /></a>
      </div>
    </section>
    <p class="paparian-position-note">These are Paparian’s published views, not a campaign endorsement.</p>

    <section class="editorial-excerpts" aria-labelledby="excerpts-title">
      <div class="editorial-section-heading">
        <h2 id="excerpts-title">Earlier commentary</h2>
        <p class="editorial-byline">{earlier.publication} · <time datetime={earlier.publishedDate}>{earlier.published}</time></p>
        <p class="editorial-earlier-heading">Public safety first. Budget priorities matter.</p>
        <a class="text-link" href={earlier.url} target="_blank" rel="noopener noreferrer">Read the full commentary in the Pasadena Star-News<span class="sr-only"> (opens in a new tab)</span> <Icon name="external" /></a>
      </div>
      <div class="editorial-quote-grid">
        <figure class="editorial-quote">
          <blockquote cite={earlier.url}><p>“{earlier.quotes.service}”</p></blockquote>
        </figure>
        <figure class="editorial-quote">
          <blockquote cite={earlier.url}><p>“{earlier.quotes.accountability}”</p></blockquote>
        </figure>
      </div>
      <div class="editorial-context">
        <p>Paparian opens by calling for dependable fire service. He then criticizes the Yes campaign’s advertising and argues that City Hall should have prioritized fire stations and wildfire work in its existing budget.</p>
        <p>Our campaign shares that call for better priorities. We support Pasadena’s firefighters and paramedics, and we believe the City should develop a fairer funding plan. We’re asking voters to vote NO on Measure PFD.</p>
      </div>
    </section>

    <section class="editorial-conclusion" aria-labelledby="conclusion-title">
      <h2 id="conclusion-title" class="sr-only">His call to voters</h2>
      <figure>
        <blockquote cite={earlier.url}><p>“{earlier.quotes.vote}”</p></blockquote>
      </figure>
    </section>
  </article>

  <section class="closing">
    <div class="container closing-inner">
      <h2>Vote NO on Measure PFD by November 3, 2026</h2>
      <div class="closing-action"><p>Support our firefighters. Ask City Hall for a better funding plan.</p><a class="button button-cream" href="/join/#signup">Vote NO <Icon /></a></div>
    </div>
  </section>
</Layout>
