---
import PaparianVideo from '../components/PaparianVideo.astro';
import Layout from '../layouts/Layout.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { paparian } from '../data/paparian';
const { latest, earlier } = paparian;
---
<Layout videoIds={['bill-paparian']} seoTitle="Bill Paparian on Pasadena’s Measure PFD | Vote No" title="Bill Paparian urges a NO vote on Measure PFD" description="Read former Pasadena Mayor Bill Paparian’s Pasadena Now and Pasadena Star-News commentaries opposing Measure PFD, with links to both articles.">
  <article class="editorial-article container">
    <header class="editorial-intro">
      <h1>Former Pasadena Mayor Bill Paparian urges a <span class="accent">NO vote on Measure PFD.</span></h1>
    </header>

    <section class="paparian-latest" aria-labelledby="latest-title">
      <figure class="paparian-video">
        <PaparianVideo id="paparian-video" />
      </figure>
      <div class="paparian-latest-copy">
        <h2 id="latest-title">{latest.title}</h2>
        <p>{latest.summary}</p>
        <a class="button button-outline secondary-action" href={latest.url} target="_blank" rel="noopener noreferrer">Read Paparian’s Pasadena Now op-ed<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </section>

    <section class="editorial-excerpts" aria-labelledby="excerpts-title">
      <div class="editorial-section-heading">
        <h2 id="excerpts-title">Earlier commentary</h2>
      </div>
      <div class="editorial-quote-grid">
        <figure class="editorial-quote">
          <blockquote cite={earlier.url}><p>“{earlier.quotes.service}”</p></blockquote>
        </figure>
        <figure class="editorial-quote">
          <blockquote cite={earlier.url}><p>“{earlier.quotes.accountability}”</p></blockquote>
        </figure>
      </div>
      <div class="editorial-context">
        <p>Paparian calls for fire service you can count on. He criticizes the Yes campaign’s advertising and says City Hall should fund station upgrades and wildfire work from its existing budget.</p>
        <p>We agree that fire stations and wildfire work should come first. Support our firefighters and ask City Hall for a fairer plan: vote NO on Measure PFD.</p>
      </div>
    </section>

    <section class="editorial-conclusion" aria-labelledby="conclusion-title">
      <h2 id="conclusion-title" class="sr-only">His call to voters</h2>
      <figure>
        <blockquote cite={earlier.url}><p>“{earlier.quotes.vote}”</p></blockquote>
      </figure>
      <a class="button button-outline secondary-action" href={earlier.url} target="_blank" rel="noopener noreferrer">Read Paparian’s Star-News commentary<span class="sr-only"> (opens in a new tab)</span></a>
    </section>
  </article>

  <section class="container editorial-related" aria-label="Related factual guides"><h2>What PFD could mean for you</h2><GuideLinks /></section>

  <section class="closing">
    <div class="container closing-inner">
      <h2>Vote NO on Measure PFD by November 3, 2026</h2>
      <div class="closing-action"><p>Support our firefighters. Ask City Hall for a better funding plan.</p><a class="button button-cream" href="/join/">Vote NO</a></div>
    </div>
  </section>
</Layout>
