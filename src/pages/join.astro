---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PreviewForms from '../components/PreviewForms.astro';
import { campaign } from '../data/campaign';
const interests = ['Pledge my NO vote', 'Display a yard sign', 'Volunteer', 'Endorse publicly', 'Write a letter to the editor'];
const roles = ['Homeowner', 'Renter', 'Small housing provider', 'Business owner', 'Retiree'];
---
<Layout title="Join the campaign" description="Learn how to get involved with No on Measure PFD and contact the campaign. Local preview forms do not send or store information.">
  <section class="page-intro container"><h1>Stand with<br />Pasadena.</h1><div class="intro-bottom"><p>Support our firefighters and paramedics. Help us ask for a fairer funding plan. There’s a place for you in this campaign.</p><span class="intro-note">No on Measure PFD<br /><strong>November 3, 2026</strong></span></div></section>
  <section id="pledge" class="join-section container section-anchor">
    <div class="section-heading"><h2>Let’s do<br />this together.</h2><p>Tell us how you’d like to take part, whether that’s a yard sign, a conversation with a neighbor, or time volunteering.</p><div class="preview-note"><span class="eyebrow">You’re viewing a local preview</span><p>These forms are for review. They don’t send or save information. You can contact the campaign directly below.</p></div><a class="text-link" href="#contact">Contact the campaign <Icon /></a></div>
    <form class="campaign-form" data-preview-form aria-labelledby="signup-title" autocomplete="off"><h3 id="signup-title">Count me in.</h3><p class="form-legend">Fields marked * are required.</p><div class="form-grid"><label>First name *<input name="firstName" autocomplete="off" maxlength="80" required /></label><label>Last name *<input name="lastName" autocomplete="off" maxlength="80" required /></label><label class="full-width">Email *<input type="email" name="email" autocomplete="off" maxlength="254" required /></label><label>Mobile phone <span class="optional">(optional)</span><input type="tel" name="phone" autocomplete="off" maxlength="30" aria-describedby="phone-note" /><small id="phone-note">Required if you select text updates.</small></label><label>ZIP code *<input name="zip" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" title="Enter a 5-digit ZIP code or ZIP+4." autocomplete="off" required /></label></div><fieldset><legend>I am a… <span class="optional">(optional)</span></legend><div class="checkbox-grid">{roles.map(role => <label class="checkbox-label"><input type="checkbox" name="role" value={role} /><span>{role}</span></label>)}</div></fieldset><fieldset><legend>I want to… <span class="optional">(optional)</span></legend><div class="checkbox-grid">{interests.map(interest => <label class="checkbox-label"><input type="checkbox" name="interest" value={interest} /><span>{interest}</span></label>)}</div></fieldset><label class="checkbox-label consent"><input type="checkbox" name="sms" /><span>I’d like text updates. <small>Preview selection only. No consent is collected and no messages will be sent. Text updates will require finalized consent terms before launch.</small></span></label><button class="button" type="submit" disabled>Preview signup <Icon /></button><noscript><p>JavaScript is needed to preview this form. Contact the campaign below.</p></noscript><p class="form-status" role="status" tabindex="-1"></p><p class="form-privacy">Read how this preview handles information in our <a href="/privacy/">privacy notice</a>.</p></form>
  </section>
  <section class="endorse-section"><div class="container endorse-inner"><h2>Lend your name.</h2><p>Interested in a public endorsement? Contact the campaign to discuss adding your name. Endorsements will appear here after permission is confirmed.</p><a class="text-link" href={`mailto:${campaign.contact.email}?subject=Measure%20PFD%20endorsement`}>Ask about endorsing <Icon /></a></div></section>
  <section id="contact" class="contact-section container section-anchor"><div class="section-heading"><h2>A question?<br />We’re here.</h2><p>For campaign questions or media inquiries, contact:</p><address class="contact-card"><strong>{campaign.contact.name}</strong><a href={`mailto:${campaign.contact.email}`}>{campaign.contact.email}</a><a href={`tel:${campaign.contact.telephone}`}>{campaign.contact.phone}</a></address><div class="press-downloads"><span class="eyebrow">For the press</span><a href="/downloads/measure-pfd-fact-sheet.pdf" download>Fact sheet <Icon name="download" size={16} /></a><a href="/downloads/measure-pfd-faq.pdf" download>Questions & answers <Icon name="download" size={16} /></a></div></div><form class="campaign-form contact-form" data-preview-form aria-labelledby="contact-title" autocomplete="off"><h3 id="contact-title">Send a note.</h3><p class="form-legend">Local preview. Nothing is sent or saved.</p><div class="form-grid"><label class="full-width">Name *<input name="name" autocomplete="off" required maxlength="160" /></label><label class="full-width">Email *<input type="email" name="email" autocomplete="off" required maxlength="254" /></label><label>Phone <span class="optional">(optional)</span><input type="tel" name="phone" autocomplete="off" maxlength="30" /></label><label>Topic *<select name="topic" required><option value="">Select a topic</option><option>General question</option><option>Volunteer</option><option>Media</option><option>Endorsement</option></select></label><label class="full-width">Message *<textarea name="message" rows="5" maxlength="5000" required></textarea></label></div><button type="submit" class="button" disabled>Preview message <Icon /></button><noscript><p>JavaScript is needed to preview this form. Use the email address or phone number alongside it.</p></noscript><p class="form-status" role="status" tabindex="-1"></p><p class="form-privacy">Fields marked * are required. <a href="/privacy/">Privacy notice</a></p></form></section>
  <PreviewForms />
</Layout>
