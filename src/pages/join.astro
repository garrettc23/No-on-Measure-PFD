---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CampaignForms from '../components/CampaignForms.astro';
import { campaign } from '../data/campaign';
---
<Layout title="Join the campaign" description="Help oppose Pasadena Measure PFD. Join our campaign, volunteer, or contact Matt Klink with a question.">
  <section id="top" class="page-intro container"><h1>Stand with Pasadena.</h1><div class="intro-bottom"><p>You can support Pasadena’s firefighters and ask for a fairer tax plan. Join us in opposing Measure PFD and keeping Pasadena affordable.</p></div></section>
  <section id="pledge" class="join-section container section-anchor">
    <div class="section-heading"><h2>Join the<br />campaign.</h2><p>Add your support for a NO vote on Measure PFD.</p><p>Not sure how you want to help? Use the <a href="#contact">contact form below</a> to ask about volunteering, campaign materials, or an endorsement. Review the <a href="/facts/">Measure PFD facts</a> and <a href="/vote/">voting guide</a> before deciding. Our <a href="/privacy/">privacy notice</a> explains how your signup details are handled.</p></div>
    <form id="signup" class="campaign-form" method="post" action="/api/forms/" data-campaign-form="signup" aria-labelledby="signup-title" autocomplete="off"><h3 id="signup-title">Join the campaign.</h3><p class="form-legend">Leave your contact details so Matt Klink can help you get involved. Fields marked * are required.</p><div class="form-grid"><label>First name *<input name="firstName" autocomplete="off" maxlength="80" required /></label><label>Last name *<input name="lastName" autocomplete="off" maxlength="80" required /></label><label class="full-width">Email *<input type="email" name="email" autocomplete="off" maxlength="254" required /></label><label>Phone <span class="optional">(optional)</span><input type="tel" name="phone" autocomplete="off" maxlength="30" /></label><label>ZIP code *<input name="zip" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" title="Enter a 5-digit ZIP code or ZIP+4." autocomplete="off" required /></label></div><div class="form-honeypot" aria-hidden="true"><label>Leave this blank<input name="website" autocomplete="off" tabindex="-1" maxlength="200" /></label></div><noscript><p>JavaScript is needed to send this form. Contact the campaign below.</p></noscript><p class="form-status" role="status" tabindex="-1"></p><button class="button" type="submit" disabled>Join the campaign</button></form>
  </section>
  <section class="endorse-section"><div class="container endorse-inner"><h2>Lend your name.</h2><p>Want to publicly support a NO vote? Contact us about adding your name. We’ll ask your permission before publishing an endorsement.</p><a class="button button-outline secondary-action" href={`mailto:${campaign.contact.email}?subject=Measure%20PFD%20endorsement`}>Offer your endorsement</a></div></section>
  <section id="contact" class="contact-section container section-anchor"><div class="section-heading"><h2>Contact our<br />campaign.</h2><p>Have a question or want to help? Email or call Matt Klink:</p><address class="contact-card"><strong>{campaign.contact.name}</strong><a href={`mailto:${campaign.contact.email}`}>{campaign.contact.email}</a><a href={`tel:${campaign.contact.telephone}`}>{campaign.contact.phone}</a></address>{campaign.factSheetUrl && <div class="press-downloads"><a href={campaign.factSheetUrl} type="application/pdf" download>Download fact sheet (PDF) <Icon name="download" size={16} /></a></div>}</div><form class="campaign-form contact-form" method="post" action="/api/forms/" data-campaign-form="contact" aria-labelledby="contact-title" autocomplete="off"><h3 id="contact-title">Send a message.</h3><p class="form-legend">Tell Matt Klink what’s on your mind or how you’d like to help. Fields marked * are required.</p><div class="form-grid"><label class="full-width">Name *<input name="name" autocomplete="off" required maxlength="160" /></label><label class="full-width">Email *<input type="email" name="email" autocomplete="off" required maxlength="254" /></label><label>Phone <span class="optional">(optional)</span><input type="tel" name="phone" autocomplete="off" maxlength="30" /></label><label>Topic *<select name="topic" required><option value="">Select a topic</option><option>General question</option><option>Volunteer</option><option>Media</option><option>Endorsement</option></select></label><label class="full-width">Message *<textarea name="message" rows="5" maxlength="5000" required></textarea></label></div><div class="form-honeypot" aria-hidden="true"><label>Leave this blank<input name="website" autocomplete="off" tabindex="-1" maxlength="200" /></label></div><noscript><p>JavaScript is needed to send this form. Use the email address or phone number alongside it.</p></noscript><p class="form-status" role="status" tabindex="-1"></p><button type="submit" class="button" disabled>Send message</button></form></section>
  <CampaignForms />
</Layout>

<style>
  .page-intro h1 { width: 100%; max-width: none; white-space: nowrap; }
  @media (max-width: 800px) {
    .page-intro h1 { font-size: clamp(24px, 7.5vw, 50px); }
  }
  .form-honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  #signup { scroll-margin-top: 16px; }
  #signup > .button { margin-top: 25px; }
  @media (max-width: 800px) {
    /* Offset the shared 150px scroll padding so the form clears the mobile header. */
    #signup { scroll-margin-top: -40px; }
  }
  @media screen and (min-width: 801px) and (min-height: 700px) {
    .join-section > .section-heading,
    .contact-section > .section-heading { position: sticky; top: 150px; align-self: start; }
  }
</style>
