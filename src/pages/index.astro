---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Closing from '../components/Closing.astro';
import TaxCallout from '../components/TaxCallout.astro';
import homes from '../assets/pasadena-del-rosa-homes.jpg';
import CampaignVideo from '../components/CampaignVideo.astro';
import PaparianVideo from '../components/PaparianVideo.astro';
import { paparian } from '../data/paparian';
import ResourceTiles from '../components/ResourceTiles.astro';
import { guides } from '../data/guides';
const featuredResources = ['/measure-pfd-calculator/', '/measure-pfd-pass-or-fail/'].map(path => guides.find(guide => guide.path === path)!).map(guide => ({ href: guide.path, title: guide.name, text: guide.summary, action: guide.action }));
---
<Layout videoIds={['kitchen-table', 'bill-paparian']} seoTitle="No on Measure PFD | Pasadena Parcel Tax, November 2026" description="Vote No on Pasadena Measure PFD on November 3, 2026. Estimate your added property tax, check exemptions, and learn why our campaign opposes this parcel tax.">
  <section class="hero container">
    <div class="hero-copy">
      <h1><span class="hero-support"><span>Support Pasadena’s</span> <span>firefighters.</span></span><br /><span class="accent"><strong class="vote-no">Vote NO</strong> on<br />Measure PFD.</span></h1>
      <p class="hero-description">Measure PFD could add $4,000+ to your property taxes over 14 years. Vote NO for a fairer way to fund public safety.</p>
    </div>
    <figure class="hero-figure">
      <CampaignVideo id="kitchen-table-video" src="/videos/kitchen-table.mp4" poster="/videos/kitchen-table-poster.webp" captions="/videos/kitchen-table.en.vtt" label="Kitchen Table" width={1280} height={720} />
    </figure>
    <div class="hero-actions"><a href="/join/" class="button">Vote NO</a><a href="/facts/" class="button button-outline secondary-action">Get the Measure PFD facts</a></div>
  </section>

  <TaxCallout />

  <section class="numbers-section" aria-labelledby="numbers-title">
    <div class="container">
      <div class="numbers-heading"><h2 id="numbers-title">What’s on the ballot</h2><a href="/facts/" class="button button-outline button-small">See what PFD would cost</a></div>
      <div class="numbers-grid">
        <div class="number-item"><span class="stat-number">19<span>¢</span></span><div><h3>Per square foot. Every year.</h3><p>Based on taxable building area,<br class="desktop-break" /> before exemptions.</p></div></div>
        <div class="number-item"><span class="stat-number">$304</span><div><h3>For a 1,600 sq. ft. home.</h3><p>Added property tax each year,<br class="desktop-break" /> before exemptions.</p></div></div>
        <div class="number-item"><span class="stat-number">14<span> years</span></span><div><h3>A long-term commitment.</h3><p>The tax expires 14 years<br class="desktop-break" /> after it takes effect.</p></div></div>
      </div>
    </div>
  </section>

  <section class="position-section container">
    <div class="section-heading"><h2>Strong public safety.<br />A fair share of the cost.</h2></div>
    <div class="position-body"><p class="lead">You should be able to count on help when you call 911. Pasadena’s firefighters, police, and paramedics need reliable funding to do their jobs.</p><p>Measure PFD would bill property owners based on building size. Public safety serves residents, businesses, and visitors alike. We believe City Hall should share that cost more broadly.</p><a href="/facts/#questions" class="button button-outline secondary-action">Get answers about PFD</a></div>
  </section>

  <section class="paparian-feature container" aria-labelledby="paparian-feature-title">
    <div class="paparian-feature-inner">
      <figure class="paparian-portrait"><PaparianVideo id="homepage-paparian-video" /></figure>
      <div class="paparian-feature-copy">
        <h2 id="paparian-feature-title">Former Mayor Bill Paparian urges a <span class="accent">NO vote.</span></h2>
        <p>{paparian.latest.summary}</p>
        <a href="/bill-paparian/" class="button button-outline secondary-action">Read Paparian’s latest commentary</a>
      </div>
    </div>
  </section>

  <section class="container home-guides" aria-labelledby="reference-title">
    <div class="home-guides-heading">
      <h2 id="reference-title">Understand the proposal.</h2>
      <a class="button button-outline" href="/resources/">Tools &amp; guides</a>
    </div>
    <p>Estimate your added property tax and understand what voting Yes or No on Measure PFD would mean.</p>
    <ResourceTiles items={featuredResources} label="Featured resources" className="guide-links" columns={2} />
  </section>

  <section class="neighborhood-section container">
    <figure class="neighborhood-photo">
      <Image src={homes} alt="Homes on Del Rosa Road and Grand Avenue in Pasadena" widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 50vw" format="webp" quality={85} loading="lazy" />
    </figure>
    <div class="neighborhood-copy"><h2>Another bill<br />lands at home.</h2><p>For a home with 1,600 taxable square feet, Measure PFD would add $304 a year. That is $4,256 over 14 years, before exemptions.</p><p>Rental housing is included, too. At the proposed rate, 20,000 taxable square feet would mean $3,800 a year for a building’s owner.</p><p>Housing that’s affordable is a top concern. This tax measure makes housing less affordable for Pasadena residents struggling to make ends meet.</p><a href="/measure-pfd-calculator/" class="button button-outline secondary-action">Calculate your PFD tax increase</a></div>
  </section>

  <section class="accountability-section container">
    <div><h2>Public safety deserves<br />a better plan.</h2></div>
    <div class="accountability-content"><p>Everyone who lives, works, or visits Pasadena relies on public safety. We believe a 14-year tax on property owners is an unfair way to pay for it.</p><p>Our firefighters deserve dependable support. You deserve a fairer funding plan.</p><a href="/facts/#questions" class="button button-outline secondary-action">Read the FAQ</a></div>
  </section>
  <Closing />
</Layout>

<style>
  .hero .hero-support { display: inline-block; font-size: clamp(25px, 4.1vw, 60px); line-height: 1.12; }
  .hero-support > span { display: block; white-space: nowrap; }
  @media (max-width: 800px) {
    .hero .hero-support { font-size: clamp(30px, 9.7vw, 60px); }
  }
  .home-guides-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .home-guides-heading .button { flex-shrink: 0; }
  .home-guides > p { margin-top: 12px; }
  .home-guides :global(.guide-links) { margin-top: var(--space-content); }
  @media (max-width: 600px) {
    .home-guides-heading { align-items: flex-start; gap: 16px; }
    .home-guides-heading h2 { font-size: 28px; }
    .home-guides-heading .button { padding: 12px; font-size: 14px; }
  }
  .hero { grid-template-areas: "copy video" "actions video"; row-gap: 0; }
  .hero-copy { grid-area: copy; align-self: end; }
  .hero-figure { grid-area: video; }
  .hero-actions { grid-area: actions; align-self: start; }
  @media (max-width: 800px) {
    .hero { grid-template-areas: "copy" "video" "actions"; row-gap: 28px; }
    .hero-actions { margin-top: 0; flex-direction: column; align-items: stretch; gap: 12px; }
    .hero-actions > .secondary-action { justify-content: center; }
  }
</style>
