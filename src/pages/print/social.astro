---
import '@fontsource-variable/dm-sans';
import CampaignMark from '../../components/CampaignMark.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="robots" content="noindex, nofollow" /><title>No on Measure PFD social image</title><style>body{margin:0;background:#233e34;color:#f8f5ed;width:1200px;height:630px;box-sizing:border-box;padding:45px 75px;font-family:'DM Sans Variable',Arial,sans-serif}.top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #8a9687;padding-bottom:25px}.brand{width:220px}.date{font-size:16px;letter-spacing:1px}h1{font-family:Georgia,'Times New Roman',serif;font-size:68px;line-height:1.05;font-weight:450;letter-spacing:-3px;margin:30px 0 25px}p{font-size:22px;margin:0;color:#e0e4d1}.bottom{font-size:14px;letter-spacing:2px;margin-top:45px;text-transform:uppercase}</style></head><body><div class="top"><div class="brand"><CampaignMark /></div><div class="date">PASADENA · NOVEMBER 3, 2026</div></div><h1>Support Pasadena’s firefighters.<br />Vote NO on Measure PFD.</h1><p>Support public safety. Keep Pasadena affordable.</p><div class="bottom">Measure PFD is the wrong solution to a serious problem.</div></body></html>
