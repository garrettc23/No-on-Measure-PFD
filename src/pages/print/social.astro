---
import cityHall from '../../assets/pasadena-city-hall.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Vote No on Measure PFD</title>
    <style>
      * { box-sizing: border-box; }
      body { position: relative; isolation: isolate; overflow: hidden; margin: 0; width: 1200px; height: 630px; background: #f7f5f0; }
      /* Center the building's tower within the right tile, rather than the source frame. */
      .city-hall { position: absolute; z-index: -3; left: 600px; top: 0; width: 600px; height: 630px; object-fit: cover; object-position: 58% center; }
      .photo-tone { position: absolute; z-index: -2; inset: 0 0 0 600px; background: linear-gradient(180deg, rgb(1 39 85 / 5%), transparent 55%, rgb(1 39 85 / 22%)); }
      .veil { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, #f7f5f0 0%, #f7f5f0 50%, rgb(247 245 240 / 25%) 59%, transparent 67%); }
      .logo { position: absolute; left: 300px; top: 50%; transform: translate(-50%, -50%); display: block; width: 580px; height: 580px; object-fit: contain; }
      .rule { position: absolute; inset: auto 0 0; height: 8px; background: #012755; }
      .rule::before { content: ''; display: block; width: 600px; height: 100%; background: #e00014; }
    </style>
  </head>
  <body>
    <img class="city-hall" src={cityHall.src} alt="Pasadena City Hall" />
    <div class="photo-tone"></div><div class="veil"></div>
    <img class="logo" src="/social-logo.png" alt="Vote No on Measure PFD" width="1260" height="1260" />
    <div class="rule"></div>
  </body>
</html>
