---
import '@fontsource-variable/archivo';
import '@fontsource-variable/public-sans';
import CampaignMark from '../../components/CampaignMark.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="robots" content="noindex, nofollow" /><title>No On Measure PFD Social Image</title><style>body{margin:0;background:#012755;color:#ffffff;width:1200px;height:630px;box-sizing:border-box;padding:45px 75px;font-family:'Public Sans Variable',Arial,sans-serif}.top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #5b6f92;padding-bottom:25px}.bottom{border-top:6px solid #e00a14;padding-top:18px}.brand{width:130px}.date{font-size:16px;letter-spacing:1px}h1{font-family:'Archivo Variable',Arial,sans-serif;font-size:62px;line-height:1.08;font-weight:750;letter-spacing:-2px;margin:30px 0 25px}p{font-size:22px;margin:0;color:#dde4ef}.bottom{font-size:14px;letter-spacing:2px;margin-top:45px;text-transform:uppercase}</style></head><body><div class="top"><div class="brand"><CampaignMark /></div><div class="date">PASADENA · NOVEMBER 3, 2026</div></div><h1>Support Pasadena’s firefighters.<br />Vote NO on Measure PFD.</h1><p>Support public safety. Keep Pasadena affordable.</p><div class="bottom">Measure PFD is the wrong solution to a serious problem.</div></body></html>
