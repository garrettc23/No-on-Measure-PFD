---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { starNews } from '../data/starNews';
---
<Layout seoTitle="Pasadena Star-News Editorial: No on Measure PFD" title="Pasadena Star-News urges a NO vote on Measure PFD" description="The Pasadena Star-News Editorial Board recommends voting No on Measure PFD. Read excerpts from its editorial and the original article.">
  <article class="editorial-article star-news-article container">
    <header class="editorial-intro">
      <h1>Pasadena Star-News urges a <span class="accent">NO vote on Measure PFD.</span></h1>
      <a class="text-link" href={starNews.url} target="_blank" rel="noopener noreferrer">Read the full editorial<span class="sr-only"> (opens in a new tab)</span> <Icon name="external" /></a>
    </header>

    <section class="editorial-excerpts" aria-labelledby="excerpts-title">
      <div class="editorial-section-heading"><h2 id="excerpts-title">Public safety first.<br />Budget priorities matter.</h2></div>
      <figure class="editorial-quote star-news-excerpt">
        <blockquote cite={starNews.url} data-attributed-quote aria-describedby="safety-attribution">
          {starNews.publicSafety.map(paragraph => <p>{paragraph}</p>)}
        </blockquote>
        <figcaption id="safety-attribution">{starNews.author}, {starNews.publication}</figcaption>
      </figure>
    </section>

    <section class="editorial-conclusion" aria-labelledby="conclusion-title">
      <h2 id="conclusion-title" class="sr-only">The editorial board’s recommendation to voters</h2>
      <figure>
        <blockquote cite={starNews.url} data-attributed-quote aria-describedby="conclusion-attribution"><p>{starNews.conclusion}</p></blockquote>
        <figcaption id="conclusion-attribution">{starNews.author}, {starNews.publication}</figcaption>
      </figure>
    </section>
  </article>

  <section class="closing">
    <div class="container closing-inner">
      <h2>Vote NO on Measure PFD by November 3, 2026</h2>
      <div class="closing-action"><p>Support our firefighters. Ask City Hall for a better funding plan.</p><a class="button button-cream" href="/join/#signup">Vote NO <Icon /></a></div>
    </div>
  </section>
</Layout>

<style>
  .star-news-excerpt { max-width: 920px; margin-top: 32px; }
  .star-news-excerpt blockquote p { font-family: var(--sans); font-weight: 400; letter-spacing: 0; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.65; }
  .editorial-conclusion blockquote p { font-size: clamp(24px, 2.3vw, 32px); line-height: 1.5; }
</style>
