---
import Layout from '../layouts/Layout.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { starNews } from '../data/starNews';
---
<Layout seoTitle="Pasadena Star-News Editorial: No on Measure PFD" title="Pasadena Star-News urges a NO vote on Measure PFD" description="Why does the Pasadena Star-News oppose Measure PFD? Read its case for funding public safety first, with a link to its full editorial.">
  <article class="editorial-article star-news-article container">
    <header class="editorial-intro">
      <h1>Pasadena Star-News urges a <span class="accent">NO vote on Measure PFD.</span></h1>
    </header>

    <section class="editorial-excerpts" aria-labelledby="excerpts-title">
      <div class="editorial-section-heading">
        <h2 id="excerpts-title">Public safety first.<br />Budget priorities matter.</h2>
        <a class="button button-outline secondary-action" href={starNews.url} target="_blank" rel="noopener noreferrer">Read the full editorial<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <figure class="editorial-quote star-news-excerpt">
        <blockquote cite={starNews.url} data-attributed-quote>
          {starNews.publicSafety.map(paragraph => <p>{paragraph}</p>)}
        </blockquote>
      </figure>
    </section>

    <section class="editorial-conclusion" aria-labelledby="conclusion-title">
      <h2 id="conclusion-title" class="sr-only">The editorial board’s recommendation to voters</h2>
      <p class="editorial-summary">{starNews.conclusionSummary}</p>
    </section>
  </article>

  <section class="container editorial-related" aria-label="Related factual guides"><h2>What PFD could mean for you</h2><GuideLinks /></section>

  <section class="closing">
    <div class="container closing-inner">
      <h2>Vote NO on Measure PFD by November 3, 2026</h2>
      <div class="closing-action"><p>Support our firefighters. Ask City Hall for a better funding plan.</p><a class="button button-cream" href="/join/">Vote NO</a></div>
    </div>
  </section>
</Layout>

<style>
  .editorial-section-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-content); flex-wrap: wrap; }
  .editorial-section-heading > .secondary-action { margin-top: 0; flex-shrink: 0; text-align: center; }
  @media (max-width: 600px) {
    .editorial-section-heading > .secondary-action { width: 100%; }
  }
  .star-news-excerpt { margin-top: 32px; }
  .star-news-excerpt blockquote p { font-family: var(--sans); font-weight: 400; letter-spacing: 0; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.65; }
  .editorial-summary { font-family: var(--display); font-weight: 600; letter-spacing: -.015em; font-size: clamp(24px, 2.3vw, 32px); line-height: 1.5; }
</style>
